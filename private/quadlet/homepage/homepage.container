[Unit]
Description=Application dashboard

[Container]
Image=ghcr.io/gethomepage/homepage:latest
ContainerName=homepage
HostName=homepage
AutoUpdate=registry

# User
UserNS=keep-id
User=%U
Group=%G

Network=homepage.network

Environment=HOMEPAGE_ALLOWED_HOSTS=homepage.seterlab.no,localhost:3000
Environment=LOG_TARGETS=stdout

Volume=%h/repos/seterlab/private/homepage/config:/config:Z
Volume=%h/repos/seterlab/private/homepage/public:/app/public/icons:Z

[Service]
Restart=always
ExecStartPost=-/usr/bin/podman exec nginx nginx -s reload

[Install]
WantedBy=default.target
