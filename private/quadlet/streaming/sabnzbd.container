[Unit]
Description=SABnzbd usenet downloader

[Container]
# Image
Image=lscr.io/linuxserver/sabnzbd:latest
ContainerName=sabnzbd
HostName=sabnzbd
AutoUpdate=registry

# User 
UserNS=keep-id
User=0
Group=0
Environment=PUID=1000
Environment=PGID=1000

# Environment
Environment=TZ=Europe/Oslo

# Network
Network=media.network

# Storage
Volume=%h/.appdata/seterlab/streaming/sabnzbd/config:/config:Z
Volume=%h/scratch/streaming/incomplete:/data/downloads/incomplete:Z
Volume=/data/seterlab/streaming/data:/data:z

# Security
NoNewPrivileges=true

[Service]
Restart=always
ExecStartPost=-/usr/bin/podman exec nginx nginx -s reload

[Install]
WantedBy=default.target
