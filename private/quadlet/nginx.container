[Unit]
Description=Nginx reverse proxy

[Container]
Image=docker.io/library/nginx:stable-trixie
ContainerName=nginx
AutoUpdate=registry

Network=homepage.network
Network=crafty.network
Network=flybymedia.network
Network=media.network
PublishPort=443:443 
PublishPort=80:80

Volume=%h/repos/seterlab/private/nginx/conf.d:/etc/nginx/conf.d:ro,Z
Volume=%h/.appdata/seterlab/certbot/config:/etc/letsencrypt:ro,z

[Service]
Restart=always

[Install]
WantedBy=default.target
