[Unit]
Description=Aalesund Rental API
Requires=rental-db.service
After=rental-db.service

[Container]
Image=localhost/rental-api:latest
ContainerName=rental-api
HostName=rental-api

Network=rental.network
Network=rental-db.network

Environment=SPRING_DATASOURCE_URL=jdbc:mysql://rental-db:3306/rental
Environment=SPRING_DATASOURCE_USERNAME=admin
Environment=SPRING_DATASOURCE_PASSWORD=admin123
Environment=JWT_SECRET_KEY=qZx9pL2wK7mN4vJ8hR5tY3uI6oE1aS0dF3gH9jB4kC2lM5nX8qW7eT6rU1yP0iA3sD2fG5hJ4kL9mN8vB1cQ6wE2
Environment=CORS_ALLOWED_ORIGINS=https://rental.seterlab.no

NoNewPrivileges=true

[Service]
Restart=always

RestartSec=10

[Install]
WantedBy=default.target
