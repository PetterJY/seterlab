[Unit]
Description=Radarr movie manager

[Container]
# Image
Image=lscr.io/linuxserver/radarr:latest
ContainerName=radarr
HostName=radarr
AutoUpdate=registry

# User 
UserNS=keep-id
User=0
Group=0
Environment=PUID=1000
Environment=PGID=1000

# Environment
Environment=TZ=Europe/Oslo

# Network
Network=media.network

# Storage
Volume=%h/.appdata/seterlab/streaming/radarr/config:/config:Z
Volume=/data/seterlab/streaming/data:/data:z

# Security
NoNewPrivileges=true

[Service]
Restart=always
ExecStartPost=-/usr/bin/podman exec nginx nginx -s reload

[Install]
WantedBy=default.target
